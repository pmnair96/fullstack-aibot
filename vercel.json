    "OPENROUTER_MODEL": "deepseek/deepseek-chat-v3-0324:free",
    "OPENROUTER_SITE_URL": "https://fullstack-aibot.vercel.app",
    "OPENROUTER_APP_NAME": "Genie-AI-Assistant"
  }
}