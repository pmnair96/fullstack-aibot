{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/fullstack-aibot"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/dist/fullstack-aibot/$1"
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18"
    }
  }
}
